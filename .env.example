# Copy this file to .env and fill in your values
# For Vercel, add these as Environment Variables in the dashboard

# JWT Secret (required - use a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars

# MySQL Database (required for production - use PlanetScale, Railway, or any MySQL host)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=petroleum_supply_chain
MYSQL_PORT=3306

# SMTP Email (optional - for OTP password reset emails)
# If not set, OTP will be shown in the API response (dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
